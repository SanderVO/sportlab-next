],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"ol\",\"0\",{\"className\":\"list-decimal pl-6 space-y-2\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"span\",\"0\",{\"style\":{},\"children\":[\"In de trainingszaal waar Sportlab gebruik van maakt is het niet toegestaan voor de sporter om te eten of zoete dranken te nuttigen of open in de ruimte te hebben liggen. Alleen water in een bidon of flesje met dop is toegestaan. De dranken of etenswaren kunnen genuttigd worden in de kantine.\"]}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"span\",\"0\",{\"style\":{},\"children\":[\"Sportlab streeft een gezonde leefstijl na en in of rondom de trainingslocatie wordt niet gerookt door de sporter voor of na de training. Een rookvrije sportorganisatie.\"]}]]}]]}]]}]]}]\n25:[\"$\",\"p\",\"40\",{\"children\":[\"$\",\"br\",null,{}]}]\n26:[\"$\",\"ol\",\"41\",{\"className\":\"list-decimal pl-6 space-y-2\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"span\",\"0\",{\"style\":{},\"children\":[\"$\",\"strong\",null,{\"children\":[\"Gedrag sporter\"]}]}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"ol\",\"0\",{\"className\":\"list-decimal pl-6 space-y-2\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"span\",\"0\",{\"style\":{},\"children\":[\"Sportlab kan zonder opgaaf van redenen personen de toegang weigeren.\"]}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"span\",\"0\",{\"style\":{},\"children\":[\"De sporter onderwerpt zich aan de door Sportlab (nader) vast te stellen reglementen en huishoudelijke regels en verklaart hierbij die reglementen en regels te zullen naleven.\"]}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"span\",\"0\",{\"style\":{},\"children\":[\"De sporter houdt zich aan beslissingen en instructies, gegeven door de directie en/of de instructeur die de sportactiviteit begeleidt. Bezoekers/toeschouwers bemoeien zich niet met de (inhoud) van de sportactiviteit. \"]}]]}],[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"span\",\"0\",{\"style\":{},\"children\":[\"De sporter zorgt ervoor dat hij/zij minimaal 5 minuten voor aanvang van de sportactiviteit aanwezig is.\"]}]]}],[\"$\",\"li\",\"4\",{\"children\":[[\"$\",\"span\",\"0\",{\"style\":{},\"children\":[\"De sporter dient na afloop van de sportactiviteit geleende/gehuurde attributen (handschoenen, scheenbeschermers, pads, kussens, etc.) geordend op te ruimen.\"]}]]}],[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"span\",\"0\",{\"style\":{},\"children\":[\"Elk handelen, nalaten of gedrag van een sporter of bezoeker van Sportlab in strijd met één of meer bepalingen van deze voorwaarden, voornoemde reglementen en regels en/of andere handelingen welke de naam en/of de gang van zaken van Sportlab kunnen benadelen, geeft Sportlab en/of diens vertegenwoordigers het recht met onmiddellijke ingang het lidmaatschap te beëindigen en de betrokkene(n) de toegang tot het sportcentrum te ontzeggen, zonder dat dit grond oplevert tot restitutie van inschrijf-/entreegeld of contributie.\"]}]]}],[\"$\",\"li\",\"6\",{\"children\":[[\"$\",\"span\",\"0\",{\"style\":{},\"children\":[\"Bij bezit, gebruik van of handelen in verboden stimulerende middelen, behoudt Sportlab het recht om de training direct stop te zetten, waarbij de toegang voorgoed kan worden ontzegd.\"]}]]}]]}]]}]]}]\n27:[\"$\",\"p\",\"42\",{\"children\":[\"$\",\"br\",null,{}]}]\n28:[\"$\",\"ol\",\"43\",{\"className\":\"list-decimal pl-6 space-y-2\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"span\",\"0\",{\"style\":{},\"children\":[\"$\",\"strong\",null,{\"children\":[\"Feestdagen en openingstijden\"]}]}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"ol\",\"0\",{\"className\":\"list-decimal pl-6 space-y-2\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"span\",\"0\",{\"style\":{},\"children\":[\"Sportlab behoudt zich het recht voor op erkende feestdagen en/of gedurende de (school)vakanties de gehele dag of een gedeelte van de dag te sluiten en/of het sportrooster aan te passen.\"]