{"value":{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":1,\"name\":\"Sportlab Groningen\",\"url\":\"www.sportlabgroningen.nl\",\"logo\":{\"id\":141,\"alt\":\"Sportschool Groningen\",\"objectPositionDesktop\":\"top\",\"objectPositionMobile\":\"center\",\"poster\":null,\"prefix\":\"images/\",\"_objectKey\":null,\"updatedAt\":\"2026-03-28T13:06:26.499Z\",\"createdAt\":\"2026-03-28T13:06:26.499Z\",\"url\":\"https://cdn.sportlabgroningen.nl/images/sportlab logo- witte letters.ai.jpg\",\"thumbnailURL\":null,\"filename\":\"sportlab logo- witte letters.ai.jpg\",\"mimeType\":\"image/jpeg\",\"filesize\":44937,\"width\":1600,\"height\":1130},\"email\":\"stefan@sportlabgroningen.nl\",\"description\":\"Een gym voor beginnende en gevorderde sporters. Community driven en met een rauw randje maken wij het sinds 2017 onze missie is om je meer en veelzijdiger te laten bewegen en trainingsprogramma’s te ontwikkelen die je zowel fysiek als mentaal verder brengen.\\n\\nWil je fitter, sterker worden of afvallen en ben je gemotiveerd om te starten? Bij Sportlab Groningen helpen we je graag op weg. Ook als je motivatie afneemt, juist dan staan wij voor je klaar om je te ondersteunen en door te zetten.\",\"contactPoint\":{\"telephone\":\"0630617295\",\"contactType\":\"Telefoon\"},\"address\":{\"streetAddress\":\"Koningsweg 27-7\",\"addressLocality\":\"Groningen\",\"postalCode\":\"9731AP\",\"addressCountry\":\"NL\"},\"geo\":{\"latitude\":53.22709,\"longitude\":6.60697},\"sameAs\":[{\"id\":\"69c7d352c6e7b275ba7eecb7\",\"url\":\"www.instagram.com/sportlabgroningen\"},{\"id\":\"69c7d35bc6e7b275ba7eecb8\",\"url\":\"https://www.facebook.com/profile.php?id=100065039711125\"},{\"id\":\"69c7d373c6e7b275ba7eecb9\",\"url\":\"https://www.linkedin.com/company/sportlabgroningen/\"},{\"id\":\"69c7d395c6e7b275ba7eecba\",\"url\":\"https://www.youtube.com/@sportlabgroningen5325\"}],\"priceRange\":null,\"openingHours\":[],\"images\":[],\"updatedAt\":\"2026-03-28T13:12:11.379Z\",\"createdAt\":\"2026-03-2