ext-lg\",\"href\":\"/small-group-training\",\"children\":[[\"$\",\"span\",\"0\",{\"style\":{},\"children\":[\"Meer info\"]}]]}]}]]}]]}]]}],null]}]]}]}]\n11:[\"$\",\"section\",\"2\",{\"className\":\"flex items-center w-full relative h-auto flex-row lg:py-12 bg-white text-background min-h-auto\",\"children\":[\"$\",\"div\",null,{\"className\":\"container mx-auto flex flex-col h-full justify-center py-15 md:py-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-gray-400\",\"children\":\"eerlijke verhalen\"}],[\"$\",\"h2\",null,{\"className\":\"text-5xl md:text-7xl font-sl-bebas text-background mt-2\",\"children\":\"SPORTERS AAN HET WOORD\"}],[\"$\",\"div\",null,{\"className\":\"border-b-4 border-background w-[100px]\"}]]}],[\"$\",\"div\",null,{\"className\":\"mt-10\",\"children\":[\"$\",\"$L19\",null,{\"id\":\"697bc7d3e45cae50fb9d3598\",\"title\":\"SPORTERS AAN HET WOORD\",\"subtitle\":\"eerlijke verhalen\",\"backgroundColor\":\"backgroundWhite\",\"blockName\":\"Reviews\",\"carouselItems\":[{\"id\":\"697bc7dde45cae50fb9d3599\",\"media\":null,\"text\":\"Bijna twee jaar geleden had ik mijn eerste personal training bij Sportlab. Door omstandigheden had ik totaal geen vertrouwen meer in mijn lichaam en durfde ik niet meer te sporten, daarnaast moest ik ook nodig was kilo’s kwijt. Dankzij Stefan heb ik weer plezier in het sporten, heb ik een goede conditie én ben ik ook nog eens 24 kilo afgevallen. ...meer\",\"name\":\"Lisette & Ahmed\",\"google_url\":\"https://share.google/pKBMkxRrVsQm0IFZa\"},{\"id\":\"697bc8167096ad000115e5d7\",\"media\":null,\"text\":\"Sportlab is absoluut een fijne plek om te zijn: een veilige haven waar je jezelf mag zijn en je echt gezien voelt. Geen spiegels, geen oordeel, geen haantjesgedrag – wél eerlijke coaching, fijne mensen en ruimte om te groeien, te leren, te falen en samen sterker te worden. Ook op dagen dat je niet op je best bent, ben je hier welkom. ...meer\",\"name\":\"Tim\",\"google_url\":\"https://share.google/VHrLrZpE6gp0vX33V\"},{\"id\":\"697bc8167096ad000115e5d8\",\"media\":null,\"text\":\"Fijne toegankelijke sfeer met trainers die altijd goed meekijken naar de techniek. Ik heb hier geleerd hoe ik oefeningen goed kan uitvoeren zonder blessures op te lopen. Absoluut een fijne plek om te trainen.\",\"name\":\"Simone\",\"google_url\":\"https://share.google/0HaRS4csKlxgjxAEg\"},{\"id\":\"697bc8167096ad000115e5d9\",\"media\":null,\"text\":\"Super club! Ik sport en nu bijna 2,5 jaar. En heb het enorm naar mijn zin. Van de super behulpzame en sociale coaches tot de relaxte sfeer en fijne mensen om samen mee te trainen. Voor mij echt een plek om te ontladen en niet druk te maken over onnodige dingen. Daarnaast worden er ook regelmatig leuke activiteiten georganiseerd zoals een ski trip, clinics en meer. Ik zou het iedereen aan raden!\",\"name\":\"Lars\",\"google_url\":\"https://share.google/0nkUJPludRUsNIHQI\"},{\"id\":\"697bc8167096ad000115e5da\",\"media\":null,\"text\":\"Een aantal jaar geleden kwam ik voor het eerst bij Sportlab. Destijds nog fanatiek aan het voetballen bij Groen Geel in de stad.\\nInmiddels ben ik al twee jaar gestopt met voetbal en sport ik meerdere keren per week bij Sportlab. Als teamsporter was dit best\\neven wennen, dacht ik. Maar al snel kwam ik erachter dat Sportlab als een team voelt. Een community. Tijdens de lessen, maar\\nook zeker daarbuiten. De kleine groepen, kunnen trainen op je eigen niveau en onderlinge competitie vind ik fijn. Je op\\nindividueel niveau kunnen verbeteren en toch trainen samen met andere, dat maakt sporten bij Sportlab voor mij leuk.\",\"name\":\"Frank\",\"google_url\":null},{\"id\":\"697bc8167096ad000115e5db\",\"media\":null,\"text\":\"Ik sport hier nu een half jaar en vind het echt heerlijk hier!\\n\\nNo nonsense, fantastische coaches en een hele relaxte sfeer.\\nMaar vergis je niet, 'one more' is niet voor niets 'de' slogan 🦾\\n\\nStefan en zijn team hebben het echt top voormekaar 👌\",\"name\":\"Remko\",\"google_url\":\"https://share.google/yWdCgGCvVPt1rt0Nm\"}],\"blockType\":\"carousel\",\"disableInnerContainer\":true}]}]]}]}]\n12:[\"$\",\"section\",\"3\",{\"className\":\"flex items-center w-full relative h-auto flex-row lg:py-12 bg-background text-sand sm:min-h-180 xxl:min-h-[1080px]\",\"children\":[\"$\",\"div\",null,{\"className\":\"container mx-auto\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col h-full justify-center py-15 md:py-0 bg-background text-white\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-sl-bebas text-5xl md:text-7xl\",\"children\":\"MEET THE TEAM\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-row justify-between mt-4 h-auto gap-20 items-center\",\"children\":[\"$\",\"$L1a\",null,{\"backgroundColor\":\"backgroundDark\",\"type\":\"carousel\",\"users\":[{\"id\":2,\"name\":\"Stefan Denninger\",\"generateSlug\":false,\"slug\":\"stefan-denninger\",\"status\":\"active\",\"roles\":[\"user\",\"coach\",\"admin\"],\"isCoach\":true,\"avatar\":null,\"subtitle\":\"Eigenaar & personal coach\",\"about\":\"\",\"position\":1,\"content\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Stefan Denninger\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"heading\",\"version\":1,\"tag\":\"h2\"},{\"children\":[{\"detail\":0,\"format\":3,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Eigenaar & personal coach\",\"type\":\"text\",\"version\":1,\"$\":{\"fontFamily\":\"montserrat\",\"color\":\"white\"}}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":3,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"“Coaching that involves, empowers and inspires.”\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Dat is waar het voor mij om draait. In 2017 startte mijn ondernemersreis met een heldere missie: mensen meer en veelzijdiger laten bewegen. Inmiddels is die reis uitgegroeid tot eigenaarschap van een prachtige en inspirerende sportstudio in Groningen.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Sportlab betekent voor mij een plek waar mensen thuis kunnen komen, weg van huis. Een plek waar naar je geluisterd wordt en waar je jezelf kunt zijn. Natuurlijk zijn we een sportstudio waar je komt om je in het zweet te werken, kilo’s te sjouwen en te werken aan een sterkere versie van jezelf. Maar we zijn ook de plek waar je nieuwe vriendschappen aangaat, even los kunt laten na een zware dag en nieuwe energie opdoet.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Met inmiddels ruim tien jaar aan ervaring heb ik gemerkt dat coachen in mijn bloed zit. Het liefst wil ik die marathon met je meelopen, ik wil je ondersteunen bij die burn-out en ik wil je fitness samen met jou naar een nieuw niveau tillen. Coachen doe ik door bij je betrokken te zijn en te letten op de kleine details. Door een samenwerking met je aan te gaan. Durf jij die ook aan te gaan?\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Maak een afspraak\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"doc\":{\"relationTo\":\"pages\",\"value\":{\"id\":2,\"title\":\"Contact\",\"slug\":\"contact\"}},\"size\":\"md\",\"variant\":\"orangeBorder\",\"linkType\":\"internal\",\"buttonSpacing\":\"md\",\"alignment\":\"left\"},\"id\":\"69c2b8c2ad0d815b6e1d02fd\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"updatedAt\":\"2026-03-24T20:44:40.030Z\",\"createdAt\":\"2026-01-06T22:14:16.876Z\",\"email\":\"stefan@sportlabgroningen.nl\",\"sessions\":[{\"id\":\"ccfe8ba7-cc4c-4df1-8de6-19aa25e41716\",\"createdAt\":\"2026-08-14T13:12:54.050Z\",\"expiresAt\":\"2026-08-14T15:12:54.050Z\"}],\"collection\":\"users\"},{\"id\":6,\"name\":\"Iska van der Vlugt\",\"generateSlug\":false,\"slug\":\"iska-van-der-vlugt\",\"status\":\"active\",\"roles\":[\"user\",\"coach\"],\"isCoach\":true,\"avatar\":null,\"subtitle\":\"Groepslesinstructeur\",\"about\":\"\",\"position\":2,\"content\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Hi! Mijn naam is Iska van der Vlugt en inmiddels ben ik al ruim 3 jaar met veel plezier werkzaam bij Sportlab.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Zelf sport ik hier ook al meer dan 4 jaar – het is echt mijn tweede thuis geworden. Sport loopt als een rode draad door mijn leven; het is niet alleen mijn passie, maar ook mijn manier om mezelf te blijven ontwikkelen.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Wat mij energie geeft? Nieuwe dingen leren, mezelf verbeteren en die groei ook terugzien in anderen.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Juist daarom vind ik het zo tof om les te geven. Ik help mensen graag om hun sportprestaties te verbeteren, maar nog belangrijker: om met plezier te komen sporten en met een glimlach de les weer te verlaten.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Want als je met plezier beweegt, komt de progressie vanzelf!\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"updatedAt\":\"2026-03-22T20:11:53.142Z\",\"createdAt\":\"2026-01-08T11:03:06.594Z\",\"email\":\"iska@sportlabgroningen.nl\",\"sessions\":[],\"collection\":\"users\"},{\"id\":3,\"name\":\"Amy McKeogh\",\"generateSlug\":false,\"slug\":\"amy-mckeogh\",\"status\":\"active\",\"roles\":[\"user\",\"coach\"],\"isCoach\":true,\"avatar\":null,\"subtitle\":\"Personal trainer & assistant manager personal training\",\"about\":\"\",\"position\":3,\"content\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Amy McKeogh\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"heading\",\"version\":1,\"tag\":\"h2\"},{\"children\":[{\"detail\":0,\"format\":3,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Personal trainer & Assistent manager personal training\",\"type\":\"text\",\"version\":1,\"$\":{\"color\":\"white\",\"fontFamily\":\"montserrat\"}}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":3,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Originally from Ireland, I'm currently studying Sports Studies in Groningen, combining my academic knowledge with my passion for fitness and performance.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"I have been involved in both individual and team sports for most of my life, but at 15, I discovered Pilates and hybrid training, which sparked my interest in helping people move and feel better. Since then, I’ve focused on helping people stay injury-free, whether they’re recovering from something or simply looking to build a stronger, more resilient body.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"At Sportlab, you will mainly find me doing personal training, as well as leading Pre/Post Natal personal training, Core & Mobility, and Strength classes. My training style focuses on pushing people beyond what they think they're capable of while ensuring a fun, safe and welcoming atmosphere. Taking your fitness to the next level by focusing on the details, I’m here to help you become the strongest and fittest version of yourself.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Maak een afspraak\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"doc\":{\"relationTo\":\"pages\",\"value\":\"$12:props:children:props:children:props:children:1:props:children:props:users:0:content:root:children:12:children:0:fields:doc:value\"},\"size\":\"md\",\"variant\":\"orangeBorder\",\"linkType\":\"internal\",\"buttonSpacing\":\"md\",\"alignment\":\"left\"},\"id\":\"69c2b8d7ad0d815b6e1d02fe\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"updatedAt\":\"2026-03-27T13:50:56.827Z\",\"createdAt\":\"2026-01-08T10:48:19.418Z\",\"email\":\"amy@sportlabgroningen.nl\",\"sessions\":[],\"collection\":\"users\"},{\"id\":7,\"name\":\"Lieuwe van der Bijl\",\"generateSlug\":false,\"slug\":\"lieuwe-van-der-bijl\",\"status\":\"active\",\"roles\":[\"user\",\"coach\"],\"isCoach\":true,\"avatar\":null,\"subtitle\":\"Personal trainer & groepslesinstructeur\",\"about\":\"\",\"position\":4,\"content\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Lieuwe van der Bijl\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"heading\",\"version\":1,\"tag\":\"h2\"},{\"children\":[{\"detail\":0,\"format\":3,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Personal trainer & groepslesinstructeur\",\"type\":\"text\",\"version\":1,\"$\":{\"fontFamily\":\"montserrat\",\"color\":\"white\"}}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":3,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Hoi! Mijn naam is Lieuwe, ik ben 25 jaar oud en sinds een paar maanden actief als trainer bij Sportlab. Via Stijn ben ik bij Sportlab terechtgekomen en ik heb het enorm naar mijn zin.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Wat ik zo leuk vind aan Sportlab is de community. Er heerst een erg leuke sfeer en iedereen gaat fijn met elkaar om. Zelf vind ik het ook leuk om actief bezig te zijn. Zo ben ik nog aan het voetballen, vind ik hardlopen leuk en pik ik waar mogelijk een lesje mee bij Sportlab.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Mijn doel als trainer is om mensen in beweging te krijgen. Dat probeer ik te doen door leuke en uitdagende lessen te maken voor iedereen. Ik vind het belangrijk dat sporters bij Sportlab zich kunnen verbeteren en uitdagen op hun eigen niveau.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Ik heb het enorm naar mijn zin bij Sportlab en ik hoop jullie allemaal nog vaak tegen te komen. 💪🏼\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Maak een afspraak\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"doc\":{\"label\":\"Contact\",\"relationTo\":\"pages\",\"value\":\"$12:props:children:props:children:props:children:1:props:children:props:users:0:content:root:children:12:children:0:fields:doc:value\"},\"size\":\"md\",\"variant\":\"orangeBorder\",\"linkType\":\"internal\",\"buttonSpacing\":\"md\",\"alignment\":\"left\"},\"id\":\"69c2b87bad0d815b6e1d02fb\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1,\"textFormat\":3}},\"updatedAt\":\"2026-03-24T16:21:46.078Z\",\"createdAt\":\"2026-02-03T12:11:54.216Z\",\"email\":\"lieuwe@sportlabgroningen.nl\",\"sessions\":[],\"collection\":\"users\"},{\"id\":5,\"name\":\"Esmee Schoonveld\",\"generateSlug\":false,\"slug\":\"esmee-schoonveld\",\"status\":\"active\",\"roles\":[\"user\",\"coach\"],\"isCoach\":true,\"avatar\":null,\"subtitle\":\"Groepslesinstructeur en communicatie manager\",\"about\":\"\",\"position\":5,\"content\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Hi! Ik ben Esmée en ondertussen al een langere tijd te vinden bij Sportlab. Wat in 2016 begon als een proefles, is uitgegroeid tot een plek waar ik me volledig thuis voel en waar ik sinds 2023 met veel plezier deel uitmaak van het Sportlab-team. Je kan me terugvinden voor de groep, maar ook achter de schermen pak ik allerlei taken op. Denk hierbij aan de social media, communicatie, marketing etc. 🤗\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Wat ik zo leuk vind aan Sportlab?🤔 De ongedwongen sfeer. Waar je mag zijn wie je bent en waar je wordt geaccepteerd. Er is oog voor elke sporter, tijd voor een goede workout, maar ook voor een kop koffie. Het is mooi om te zien dat we groeien als community en dat we allerlei leuke activiteiten mogen ondernemen. Vriendschappen ontstaan en PR's worden verbroken.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Of ik iemand tijdens een workout tot het uiterste moet drijven of een luisterend oor kan bieden? Ik streef ernaar om iedereen met een lach naar huis te laten gaan!💪🏼\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Zie ik je snel?🫵🏼\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}},\"updatedAt\":\"2026-03-30T11:19:30.892Z\",\"createdAt\":\"2026-01-08T11:01:37.262Z\",\"email\":\"esmee@sportlabgroningen.nl\",\"sessions\":[],\"collection\":\"users\"},{\"id\":4,\"name\":\"Julia Wendelaar\",\"generateSlug\":false,\"slug\":\"julia-wendelaar\",\"status\":\"active\",\"roles\":[\"user\",\"coach\"],\"isCoach\":true,\"avatar\":null,\"subtitle\":\"Groepslesinstructeur\",\"about\":\"\",\"position\":6,\"content\":{\"root\":{\"children\":[{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Hoi! Ik ben Julia en ik sport inmiddels alweer bijna zes jaar bij Sportlab. Sinds een klein jaar val ik zo nu en dan in als trainster en dat doe ik met veel plezier.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Sportlab is voor mij een plek waar ik mij thuis voel. Mijn rol bij Sportlab is een mooie combinatie van zelf trainen, andere sporters les geven en onderdeel zijn van het team en meedoen en meedenken over hoe Sportlab kan blijven groeien, zodat het ook voor andere sporters net zo’n fijne plek mag zijn als voor mijzelf.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"vers