tagram.com/sportlabgroningen/\",\"label\":\"sportlabgroningen\",\"labelColor\":\"default\"}},{\"id\":\"69831fd0d6b6ca15d1e3af2b\",\"media\":null,\"enableLink\":true,\"link\":{\"type\":\"custom\",\"newTab\":null,\"addLabel\":null,\"url\":\"https://www.instagram.com/sportlabgroningen/\",\"label\":null,\"labelColor\":\"default\"}}],\"blockType\":\"instagram\",\"disableInnerContainer\":true}]}]\n2b:Tf28,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Ik ben een beginner. Is Sportlab Groningen geschikt voor mij?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Je sport bij ons altijd onder begeleiding en we werken in kleine groepen zodat we de juiste aandacht kunnen geven. We zorgen ervoor dat de basis (houding en techniek) staat voordat we doorgaan naar het zwaardere werk.\"}},{\"@type\":\"Question\",\"name\":\"Wat houdt dat 'rauwe randje' precies in?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Het rauwe randje houdt in dat we focussen op training en resultaat, zonder onnodige luxe of afleiding, maar wel met de beste coaching en begeleiding.\"}},{\"@type\":\"Question\",\"name\":\"Moet ik al fit zijn om aan de groepslessen mee te doen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Zeker niet. Doordat we met kleine groepen werken kunnen we de lessen schalen naar jouw niveau.\"}},{\"@type\":\"Question\",\"name\":\"Hoe werkt een proefles en wat moet ik meenemen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Je boekt je les online of in onze app en je neemt sportkleding, een handdoek en water mee. Wij doen de rest.\"}},{\"@type\":\"Question\",\"name\":\"Met hoeveel mensen train ik in een groepsles?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"De maximale grootte van onze groepslessen is 10-12 deelnemers, met uitzondering van trainingsdagen op feestdagen. Op dagen als Pasen en Kerst hebben we een alternatief lesrooster.\"}},{\"@type\":\"Question\",\"name\":\"Kan ik bij jullie ook vrij trainen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Je kunt bij ons vrij trainen tijdens onze 'Open Gym' uren. Deze vind je terug in het lesrooster. Wil je trainen buiten regulieren tijden? Ook dat kan soms. In dergelijke gevallen heb je contact met een van onze trainers om te kijken wat de mogelijkheden zijn.\"}},{\"@type\":\"Question\",\"name\":\"Kan ik bij jullie mijn auto parkeren?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Je kunt bij ons parkeren op ons eigen terrein, of aan de weg. Let er wel op dat parkeren aan de weg betaald parkeren is tot 19:00. Het eerste anderhalf uur betaal je 0,50 cent per uur.\"}},{\"@type\":\"Question\",\"name\":\"Hebben jullie kleedkamers en douches?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We hebben kleedkamers om je om te kleden, maar geen douches.\"}},{\"@type\":\"Question\",\"name\":\"Zit ik vast aan een langdurig contract?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Je zit bij ons niet vast aan een langdurig contract. Onze groepsles abonnementen zijn per maand opzegbaar met inachtneming van een maand opzegtermijn. Onze personal trainingsabonnementen beginnen met pakketten van drie maanden, omdat de ervaring ons heeft geleerd dat commitment voor betere resultaten zorgt.\"}},{\"@type\":\"Question\",\"name\":\"Zijn jullie aangesloten bij Bedrijfsfitness Nederland?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We zijn niet aangesloten bij Bedrijfsfitness Nederland.\"}},{\"@type\":\"Question\",\"name\":\"Wat is het verschil tussen jullie small group training en reguliere groepslessen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Onze groepslessen zijn met een maximaal aantal deelnemers van 10-12 personen. Daardoor is de mate van aandacht en daarmee controle op kwaliteit hoog. Je zult een totaal andere beleving ervaren dan bij trainingen met een hoger aantal deelnemers per groep. Bij ons vind je geen 'entertainment fitness', maar diepgang en gerichte coaching op houding en techniek.\"}},{\"@type\":\"Question\",\"name\":\"Bieden jullie ook voedingsbegeleiding aan?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Als je bij ons een personal trainings- of coachingstraject start helpen we je ook op weg met je voeding. We zijn geen diëtisten maar wel in staat je te ondersteunen bij de beginselen van gezonde voeding en eetpatronen. Daarnaast staan we nauw in contact met diëtisten en de opleiding voeding & diëtetiek van de Hanze Hogeschool Groningen.\"}}]}24:[\"$\",\"section\",\"6\",{\"className\":\"flex items-center w-full relative h-auto flex-row lg:py-12 bg-background text-sand sm:min-h-180 xxl:min-h-[1080px]\",\"children\":[\"$\",\"div\",null,{\"className\":\"container m-auto grid grid-cols-1 gap-10 lg:gap-30 py-15 lg:py-0 h-full lg:grid-cols-1\",\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"flex h-full justify-between w-full self-center\",\"children\":[null,[\"$\",\"div\",\"69c13203d903d9c133bee655\",{\"className\":\"flex flex-col gap-4 lg:gap-0 w-full relative self-baseline\",\"children\":[null,[\"$\",\"div\",null,{\"className\":\"payload-richtext max-w-none\",\"children\":[[\"$\",\"h1\",\"0\",{\"className\":\"font-sl-bebas text-5xl md:text-7xl\",\"children\":[[\"$\",\"span\",\"child-0\",{\"className\":\"text-white block\",\"style\":\"$5:4:props:children:2:props:children:props:children:props:children:props:children:0:props:children:0:props:style\",\"children\":[\"$\",\"strong\",null,{\"children\":\"frequently asked questions\"}]}]]}],[\"$\",\"p\",\"1\",{\"children\":[\"$\",\"br\",null,{}]}],[\"$\",\"$1\",\"2\",{\"children\":[[\"$\",\"$L2a\",null,{\"id\":\"faq-jsonld-69c13211f9cf695d8f3fe677\",\"type\":\"application/ld+json\",\"strategy\":\"afterInteractive\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2b\"}}],\"$L2c\"]}]]}]]}],null]}]]}]}]\n25:[]\n2c:[\"$\",\"div\",null,{\"className\":\"w-full divide-y divide-white/20\",\"children\":[[\"$\",\"details\",\"69c13233d903d9c133bee656\",{\"className\":\"group\",\"ch