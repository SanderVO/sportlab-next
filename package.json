{
    "name": "sportlab-next",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "browserslist": {
        "production": [
            "chrome >= 120",
            "edge >= 120",
            "firefox >= 120",
            "safari >= 17",
            "ios_saf >= 17"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "scripts": {
        "dev": "next dev --no-server-fast-refresh",
        "dev:prod": "rm -rf .next && pnpm build && pnpm start",
        "build": "next build",
        "payload:generate": "pnpm run generate:types && pnpm run generate:db && pnpm run generate:importmap",
        "generate:importmap": "payload generate:importmap",
        "generate:types": "payload generate:types",
        "generate:db": "payload generate:db-schema",
        "migrate": "payload migrate",
        "migrate:fresh": "payload migrate:fresh",
        "payload": "payload",
        "start": "next start"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.9.1",
        "@next/third-parties": "^16.3.6",
        "@payloadcms/admin-bar": "3.90.2",
